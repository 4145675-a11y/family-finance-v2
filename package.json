{
  "name": "family-finance-control",
  "version": "0.0.0",
  "private": true,
  "description": "Family financial control center — couple-level source of truth for household, business and debt.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @family-finance/web",
    "build": "npm run build --workspace @family-finance/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "unit": "vitest run",
    "integration": "vitest run --config vitest.integration.config.ts",
    "scan:forbidden": "node tools/forbidden-scan.mjs",
    "check:traceability": "node tools/check-traceability.mjs",
    "check:shell": "node tools/check-built-shell.mjs",
    "verify:m0": "npm run unit && npm run scan:forbidden && npm run check:traceability",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run unit && npm run build && npm run check:shell && npm run check:client-secrets && npm run scan:forbidden && npm run check:traceability",
    "check:client-secrets": "node tools/check-client-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "globals": "17.11.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
