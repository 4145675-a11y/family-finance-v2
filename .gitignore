# dependencies
node_modules/
.pnp/
.pnp.js
.npm-cache/

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# generated by `next build`; regenerated on every build, never edited by hand
next-env.d.ts

# test / coverage artifacts
coverage/
playwright-report/
test-results/
.vitest/

# environment and secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
service-role*.json
*-firebase-adminsdk-*.json

# The household's own data. Never committed, for the obvious reason: this is a
# family's financial records, and a repository is the wrong place for them.
# ADR-0024 puts the store here; the directory is created on first run.
.data/

# local temp / uploads (import pipeline scratch space)
tmp/
.tmp/
uploads/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*

# Playwright browser binaries, kept inside the project (CLAUDE.md: no global installs)
.playwright-browsers/

# Facts about one browser-suite run: synthetic record ids and a pid. Removed at teardown.
.e2e-run/
