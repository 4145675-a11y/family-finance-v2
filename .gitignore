# dependencies
node_modules/
.pnp/
.pnp.js
.npm-cache/

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# generated by `next build`; regenerated on every build, never edited by hand
next-env.d.ts

# test / coverage artifacts
coverage/
playwright-report/
test-results/
.vitest/

# environment and secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
service-role*.json

# local temp / uploads (import pipeline scratch space)
tmp/
.tmp/
uploads/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
