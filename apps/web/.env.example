# Family Finance — environment variable NAMES with placeholders. Never values.
# Copy to .env.local (git-ignored). See docs/PRODUCTION-DATA-LAYER.md.

# Which store stands behind the household door. Silence means local_json,
# which a hosted deployment refuses (ADR-0031). Production must say so.
FAMILY_FINANCE_DATA_BACKEND=local_json

# The origin the family reaches. https on a domain; http://localhost only locally.
FAMILY_FINANCE_APP_ORIGIN=http://localhost:3100

# Supabase project (public; inlined into the browser bundle). Required when the
# backend is supabase. The key must begin with sb_publishable_ — a secret key
# is refused by its shape and must never be placed here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<from Project Settings → API Keys>

# Development fixture (never reachable in production). "on" to enable.
NEXT_PUBLIC_DEV_DATA_SOURCE=

# Integration tests and migration tools only — NOT read by the application.
# Lives in .env.integration.local at the repository root, not here.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<url-encoded-password>@<host>:5432/postgres
